# Скопировать в .env и заполнить. .env НИКОГДА не коммитить.
# Значения по умолчанию — в backend/app/core/config.py. Пустая строка здесь —
# тоже значение: она затирает умолчание. Не нужна переменная — закомментируйте.

# ── MAX ───────────────────────────────────────────────────────────
# Токен бота из @MasterBot (обязательно для бота и проверки подписи запуска)
MAX_BOT_TOKEN=
# Публичное имя бота без @: поле web_app кнопки open_app и диплинки
# max.ru/<имя>?startapp=…. Пусто — узнаётся через GET /me.
MAX_BOT_USERNAME=t355_hakaton_max_bot
MAX_API_BASE=https://platform-api2.max.ru
# Секрет вебхука — случайная строка. Сгенерировать и вписать после «=»:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (43 символа из A-Z, a-z, 0-9, «_» и «-» — формат MAX: 5–256 таких символов).
# Передаётся MAX при подписке (scripts/setup_bot.py, сторож вебхука) и сверяется с
# заголовком X-Max-Bot-Api-Secret; им же подписаны коды билетов на события — смена
# секрета меняет коды выданных билетов. Пусто — проверка секрета выключена целиком:
# вебхук принимает любой запрос, «неверный секрет → 403» в смоуке не проходит, а
# подпись билета может посчитать любой, кто читал код.
MAX_WEBHOOK_SECRET=
# Отклонять вебхук без заголовка X-Max-Bot-Api-Secret. Включать, только когда
# в логе есть «Первый вебхук после старта: заголовок … есть». Неверный секрет
# отклоняется всегда (если он задан).
MAX_WEBHOOK_REQUIRE_SECRET=false
# Сторож вебхука: при старте и каждые 30 минут сверять подписку бота с
# MINIAPP_PUBLIC_URL и снимать чужие (решение 049). true — только на основном
# сервере (на стенде включён): локальный запуск иначе уведёт бота с него.
BOT_WEBHOOK_AUTOSUBSCRIBE=false
# Корневые сертификаты Минцифры для TLS до platform-api2. В Docker задаётся
# в docker-compose.yml (/app/certs/…); здесь — для запуска без Docker.
# MAX_CA_BUNDLE=certs/russian_trusted_bundle.pem
# Сообщений в секунду в Bot API: у платформы лимит 30, держим запас
MAX_RATE_LIMIT_RPS=20

# Публичный HTTPS-адрес мини-приложения (доверенный УЦ): кнопка open_app, ссылки
# в чате, адрес проверки и QR в PDF. Локально — http://localhost:8000; пустое
# значение сделало бы ссылку проверки в PDF относительной.
MINIAPP_PUBLIC_URL=http://localhost:8000
# Домен для Caddy (профиль vps): IP сервера через дефисы, например
# 195-19-202-143.sslip.io. Без профиля vps не нужен.
PUBLIC_HOST=

# ── Вуз (подключение нового вуза — docs/05-rollout.md) ────────────
# Название в шапке PDF-справок
UNIVERSITY_NAME=Иркутский государственный университет
# Смещение времени вуза от UTC, часы: расписание, приветствие, тихие часы, даты
# в уведомлениях. Иркутск — 8, Москва — 3, Новосибирск — 7, Владивосток — 10.
UNIVERSITY_TZ_HOURS=8

# ── База данных и файлы ───────────────────────────────────────────
# В Docker обе строки переопределяет docker-compose.yml; здесь — для запуска
# бэкенда без Docker (база — контейнер db на порту 5433)
DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5433/campus
DATA_DIR=./data
# Вложения к заявкам: файлов на студента и мегабайт на весь сервер (решение 067)
UPLOADS_PER_STUDENT=20
UPLOADS_TOTAL_MB=500

# ── LLM (ассистент) ───────────────────────────────────────────────
# Ключ сервисного аккаунта Yandex Cloud (роль ai.languageModels.user) и каталог.
# Без них ассистент выключен, остальное работает.
YC_API_KEY=
YC_FOLDER_ID=
YC_OPENAI_BASE=https://ai.api.cloud.yandex.net/v1
LLM_MODEL_MAIN=yandexgpt/latest
# Не используется: дешёвая модель зарезервирована, все вызовы идут в LLM_MODEL_MAIN
# LLM_MODEL_CHEAP=yandexgpt-lite/latest
# Максимум итераций цикла вызова инструментов (решение 020)
ASSISTANT_MAX_TOOL_ITERATIONS=4
# Сколько фрагментов базы знаний подмешивать в ответ (решение 019)
RAG_TOP_K=5
# Весь ответ ассистента — не дольше стольких секунд; по таймауту и при сбое
# модели приходят выдержки из регламента, а не ошибка
ASSISTANT_TIMEOUT_SECONDS=25
# Лимит вопросов ассистенту на пользователя: столько за окно в секундах
# (20 за 10 минут). Для тестового входа из браузера — ещё и лимит с одного адреса.
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=600
ASSISTANT_RATE_LIMIT_PER_IP=40

# ── Эмбеддинги ────────────────────────────────────────────────────
EMBEDDING_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/textEmbedding
EMBEDDING_MODEL_DOC=text-search-doc/latest
EMBEDDING_MODEL_QUERY=text-search-query/latest
EMBEDDING_DIM=256

# ── Приложение ────────────────────────────────────────────────────
# Срок жизни подписи запуска MAX. Час — рекомендация документации Bridge;
# короче — сессия протухает посреди сценария.
INIT_DATA_TTL_SECONDS=3600
# Вход без подписи MAX (браузер вне мессенджера) — только для тестовых id
# 900000–999999, настоящим пользователем так не представиться.
ALLOW_DEV_AUTH=true
# Подписанная ссылка входа от бота (?lt=…): пока мини-приложение не привязано
# к боту, кнопка в чате открывает браузер, и вход идёт по этому токену.
# Пусто — секрет выводится из MAX_BOT_TOKEN. Смена секрета гасит выданные ссылки.
LINK_SECRET=
# Срок жизни ссылки, секунды (сутки)
LINK_TTL_SECONDS=86400
# Демо-вход для экспертов: кнопка «Попробовать как студент (демо)» создаёт каждому
# аккаунту свою копию демо-студента (зачётка DEMO-<id>), роль деканата — в один тап.
# Заодно режим публичного стенда: коды сотрудников общие, поэтому события и
# модерация закрыты, а в «Людях» — только синтетические авторы (решения 068, 069).
DEMO_MODE=true
# Предохранители демо-входа — только для тестовых id браузерного входа (их может
# придумать кто угодно). Аккаунты MAX с подписью или ссылкой бота не ограничены.
# Копий в час на весь сервер и с одного адреса (решение 067)
DEMO_COPIES_PER_HOUR=120
DEMO_COPIES_PER_IP_HOUR=10
# Демо-наполнение пустой базы (синтетические студенты, регламенты, события,
# расписание). Для вуза со своими данными — false вместе с DEMO_MODE=false
# и ALLOW_DEV_AUTH=false: сид создаст только шаблоны заявок.
SEED_DEMO_DATA=true
ENV=development
LOG_LEVEL=info

# ── Постоянный адрес без своего сервера (scripts/go_public.sh) ─────
# Запасной путь: на стенде — VPS с Caddy (профиль vps). Туннели ngrok и
# Cloudflare из России ненадёжны (решение 048).
# Какой туннель поднимать: tuna или ngrok.
PUBLIC_TUNNEL=tuna

# tuna.am: токен из my.tuna.am, поддомен резервируется при первом запуске.
TUNA_TOKEN=
TUNA_SUBDOMAIN=max-campus

# ngrok: с российских IP не работает (ERR_NGROK_9040), оставлен на случай VPS за рубежом.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
